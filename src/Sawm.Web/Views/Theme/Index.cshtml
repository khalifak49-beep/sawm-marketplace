@model ThemeSettings
@{
    ViewData["Title"] = "استوديو المظهر";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h5 class="fw-bold mb-1">@Icons.Render("settings", 18) استوديو المظهر</h5>
        <div class="text-muted small">اضبط ألوان المنصة وزواياها وأيقوناتها وخلفيتها — بمعاينة حيّة، ثم احفظ لتطبيقها على الجميع.</div>
    </div>
    <form asp-action="Reset" method="post" data-confirm="إعادة المظهر إلى الوضع الافتراضي؟">
        @Html.AntiForgeryToken()
        <button class="btn btn-outline-secondary btn-sm">إعادة الافتراضي</button>
    </form>
</div>

<form asp-action="Save" method="post" id="themeForm" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <!-- ── الضوابط ── -->
        <div class="col-lg-5">
            <div class="card mb-3">
                <div class="card-header">الألوان — دمج لأي مناسبة</div>
                <div class="card-body">
                    <div class="mb-2 small text-muted">قوالب جاهزة:</div>
                    <div class="d-flex flex-wrap gap-2 mb-3" id="presets">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-p="#15803D" data-s="#22C55E" data-a="#A16207">زراعي (الافتراضي)</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-p="#B91C1C" data-s="#15803D" data-a="#CA8A04">وطني عُمان</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-p="#7C3AED" data-s="#C026D3" data-a="#CA8A04">رمضان</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-p="#B45309" data-s="#CA8A04" data-a="#15803D">العيد</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-p="#0E7490" data-s="#0891B2" data-a="#15803D">بحري</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-p="#1E3A8A" data-s="#2563EB" data-a="#0EA5E9">أزرق مؤسسي</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-p="#334155" data-s="#0F766E" data-a="#CA8A04">محايد داكن</button>
                    </div>

                    @{
                        (string name, string label, string val)[] colors = new[] {
                            ("Primary", "اللون الأساسي", Model.Primary),
                            ("Secondary", "الثانوي (للتدرّج)", Model.Secondary),
                            ("Accent", "المميّز (النجوم)", Model.Accent),
                        };
                    }
                    @foreach (var c in colors)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <label class="form-label mb-0" style="width:130px">@c.label</label>
                            <input type="color" name="@c.name" id="c_@c.name" value="@c.val"
                                   class="form-control form-control-sm" style="width:52px;padding:3px;min-height:38px" />
                            <input type="text" id="t_@c.name" value="@c.val" dir="ltr"
                                   class="form-control form-control-sm" style="max-width:120px" />
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">الزوايا والأيقونات</div>
                <div class="card-body">
                    @{
                        (string name, string label, int val, int min, int max, string unit)[] ranges = new[] {
                            ("RadiusCard", "زوايا البطاقات", Model.RadiusCard, 0, 36, "px"),
                            ("RadiusButton", "زوايا الأزرار", Model.RadiusButton, 0, 30, "px"),
                            ("RadiusIcon", "زوايا الأيقونات", Model.RadiusIcon, 0, 30, "px"),
                            ("RadiusControl", "زوايا الحقول/القوائم", Model.RadiusControl, 0, 30, "px"),
                            ("IconScale", "حجم الأيقونات", Model.IconScale, 70, 160, "%"),
                        };
                    }
                    @foreach (var r in ranges)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span>@r.label</span>
                                <span class="rtl-num text-muted"><span id="v_@r.name">@r.val</span>@r.unit</span>
                            </div>
                            <input type="range" name="@r.name" id="r_@r.name" min="@r.min" max="@r.max" value="@r.val"
                                   class="form-range" />
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">الزجاج والخلفية</div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1"><span>شفافية الزجاج</span>
                            <span class="rtl-num text-muted"><span id="v_GlassOpacity">@Model.GlassOpacity</span>%</span></div>
                        <input type="range" name="GlassOpacity" id="r_GlassOpacity" min="25" max="95" value="@Model.GlassOpacity" class="form-range" />
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1"><span>قوة التمويه</span>
                            <span class="rtl-num text-muted"><span id="v_GlassBlur">@Model.GlassBlur</span>px</span></div>
                        <input type="range" name="GlassBlur" id="r_GlassBlur" min="0" max="30" value="@Model.GlassBlur" class="form-range" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">خلفية متحركة</label>
                        <select name="BgEffect" id="s_BgEffect" class="form-select">
                            <option value="mesh">ميش ثابت (الافتراضي)</option>
                            <option value="drift">انسياب بطيء</option>
                            <option value="meteors">نيازك</option>
                            <option value="bubbles">فقاعات صاعدة</option>
                            <option value="none">بدون</option>
                        </select>
                    </div>
                    <div class="mb-3 p-3 rounded" style="background:color-mix(in srgb, var(--primary) 7%, #fff); border:1px solid color-mix(in srgb, var(--primary) 20%, transparent)">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="NationalMode" id="s_NationalMode" />
                            <label class="form-check-label fw-semibold" for="s_NationalMode">الوضع الوطني — العلم والشعار والطابع الحكومي</label>
                        </div>
                        <div class="form-text">شغّله في المناسبات الوطنية لإظهار علم عُمان والشعار الرسمي والزينة الحكومية في الهيدر والفوتر وكل الشاشات، وأطفئه بعدها للعودة للتصميم العادي.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">صورة الهيدر — ارفع صورة</label>
                        <input type="file" name="headerImageFile" id="f_HeaderImage" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml"
                               class="form-control" />
                        <div class="form-text">تظهر خلف الشريط العلوي مع تعتيم يحافظ على وضوح النص. الحد الأقصى 4 ميجابايت (PNG/JPG/WEBP/GIF/SVG). تُحفظ داخل المنصة.</div>
                        @if (!string.IsNullOrWhiteSpace(Model.HeaderImageUrl))
                        {
                            <div class="mt-2 d-flex align-items-center gap-2">
                                <img id="prev_Header" src="@Model.HeaderImageUrl" alt="معاينة" style="height:40px;border-radius:8px;border:1px solid #e2e8f0" />
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="clearHeader" value="true" id="clearHeader" />
                                    <label class="form-check-label small" for="clearHeader">إزالة صورة الهيدر</label>
                                </div>
                            </div>
                        }
                        else { <img id="prev_Header" src="" alt="" hidden style="height:40px;border-radius:8px;border:1px solid #e2e8f0;margin-top:8px" /> }
                        <input type="hidden" name="HeaderImageUrl" id="s_HeaderImageUrl" value="@Model.HeaderImageUrl" />
                    </div>
                    <div class="mb-1">
                        <label class="form-label">شعار المنصة — ارفع صورة</label>
                        <input type="file" name="emblemImageFile" id="f_EmblemImage" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml"
                               class="form-control" />
                        <div class="form-text">الافتراضي شعار سلطنة عُمان الرسمي المُخزَّن داخل المنصة. ارفع صورة شعار آخر ليحلّ محلّه في الهيدر والفوتر والقائمة.</div>
                        <div class="mt-2 d-flex align-items-center gap-2" style="background:#f1f5f9;border-radius:10px;padding:6px 10px">
                            <img id="prev_Emblem" src="@(string.IsNullOrWhiteSpace(Model.EmblemImageUrl) ? "/img/oman-emblem.svg" : Model.EmblemImageUrl)" alt="معاينة الشعار" style="height:44px" />
                            <span class="small text-muted">الشعار الحالي</span>
                        </div>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="restoreEmblem" />
                            <label class="form-check-label small" for="restoreEmblem">استعادة شعار سلطنة عُمان الرسمي</label>
                        </div>
                        <input type="hidden" name="EmblemImageUrl" id="s_EmblemImageUrl" value="@Model.EmblemImageUrl" />
                    </div>
                </div>
            </div>

            <div class="card mb-3" id="fxCard" style="display:none">
                <div class="card-header">شكل النيازك وألوانها</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">الشكل</label>
                        <select name="FxShape" id="s_FxShape" class="form-select">
                            <option value="streak">خط (نيزك)</option>
                            <option value="dot">نقطة متوهّجة</option>
                            <option value="star">نجمة ✦</option>
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <label class="form-label mb-0" style="width:110px">لون النيازك</label>
                        <input type="color" name="FxColor" id="c_FxColor" value="@Model.FxColor"
                               class="form-control form-control-sm" style="width:52px;padding:3px;min-height:38px" />
                        <input type="text" id="t_FxColor" value="@Model.FxColor" dir="ltr"
                               class="form-control form-control-sm" style="max-width:120px" />
                    </div>
                    @{
                        (string name, string label, int val, int min, int max, string unit)[] fxRanges = new[] {
                            ("FxSize", "الحجم", Model.FxSize, 20, 180, "px"),
                            ("FxCount", "العدد", Model.FxCount, 3, 45, ""),
                            ("FxSpeed", "المدة (أقل = أسرع)", Model.FxSpeed, 3, 24, "s"),
                        };
                    }
                    @foreach (var r in fxRanges)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1"><span>@r.label</span>
                                <span class="rtl-num text-muted"><span id="v_@r.name">@r.val</span>@r.unit</span></div>
                            <input type="range" name="@r.name" id="r_@r.name" min="@r.min" max="@r.max" value="@r.val" class="form-range" />
                        </div>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-green w-100 btn-lg">حفظ وتطبيق على المنصة</button>
        </div>

        <!-- ── المعاينة الحيّة ── -->
        <div class="col-lg-7">
            <div class="card" style="position:sticky; top:88px">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>معاينة حيّة</span>
                    <span class="badge bg-success">تتحدّث فوراً</span>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="stat-ico">@Icons.Render("gavel", 22)</span>
                        <span class="stat-ico">@Icons.Render("wallet", 22)</span>
                        <span class="stat-ico">@Icons.Render("handshake", 22)</span>
                        <span class="stat-ico gold">@Icons.Render("star", 22)</span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6"><div class="stat-card"><span class="stat-ico">@Icons.Render("chart", 20)</span>
                            <div><div class="stat-value">128</div><div class="stat-label">مزاد نشط</div></div></div></div>
                        <div class="col-6"><div class="stat-card"><span class="stat-ico gold">@Icons.Render("trending-up", 20)</span>
                            <div><div class="stat-value">45,900</div><div class="stat-label">القيمة المتداولة</div></div></div></div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button type="button" class="btn btn-green">زر أساسي</button>
                        <button type="button" class="btn btn-outline-success">زر ثانوي</button>
                        <button type="button" class="btn btn-sm btn-green">صغير</button>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-success">نشط</span>
                        <span class="badge bg-warning">بانتظار</span>
                        <span class="badge bg-info">جديد</span>
                        <span class="role-chip">@Icons.Render("user", 13) وسيط</span>
                        <span class="rating-chip badge">@Icons.Render("star", 12) 4.8</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">حقل إدخال</label>
                        <input class="form-control" placeholder="نموذج حقل" />
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead><tr><th>المحصول</th><th>الكمية</th><th>السعر</th></tr></thead>
                            <tbody>
                                <tr><td>طماطم</td><td class="rtl-num">8 طن</td><td class="rtl-num">350</td></tr>
                                <tr><td>تمور</td><td class="rtl-num">15 طن</td><td class="rtl-num">3,100</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    (function () {
        var root = document.documentElement, body = document.body;

        function setColor(name) {
            var picker = document.getElementById('c_' + name), text = document.getElementById('t_' + name);
            var v = picker.value;
            text.value = v;
            root.style.setProperty('--' + name.toLowerCase(), v);
        }
        ['Primary', 'Secondary', 'Accent'].forEach(function (n) {
            var picker = document.getElementById('c_' + n), text = document.getElementById('t_' + n);
            picker.addEventListener('input', function () { setColor(n); });
            text.addEventListener('change', function () {
                if (/^#[0-9a-fA-F]{6}$/.test(text.value)) { picker.value = text.value; setColor(n); }
            });
        });

        // القوالب الجاهزة
        document.querySelectorAll('#presets [data-p]').forEach(function (b) {
            b.addEventListener('click', function () {
                document.getElementById('c_Primary').value = b.dataset.p; setColor('Primary');
                document.getElementById('c_Secondary').value = b.dataset.s; setColor('Secondary');
                document.getElementById('c_Accent').value = b.dataset.a; setColor('Accent');
            });
        });

        // المنزلقات
        var rangeVar = {
            RadiusCard: ['--r-card', 'px'], RadiusButton: ['--r-btn', 'px'], RadiusIcon: ['--r-icon', 'px'],
            RadiusControl: ['--r-control', 'px'], IconScale: ['--icon-scale', 'scale'],
            GlassOpacity: ['--glass-opacity', 'opacity'], GlassBlur: ['--glass-blur-amount', 'px']
        };
        Object.keys(rangeVar).forEach(function (name) {
            var el = document.getElementById('r_' + name); if (!el) return;
            el.addEventListener('input', function () {
                var out = document.getElementById('v_' + name); if (out) out.textContent = el.value;
                var spec = rangeVar[name], v = el.value;
                if (spec[1] === 'px') root.style.setProperty(spec[0], v + 'px');
                else if (spec[1] === 'scale') root.style.setProperty(spec[0], (v / 100));
                else if (spec[1] === 'opacity') root.style.setProperty(spec[0], (v / 100));
            });
        });

        // الخلفية المتحركة + شكل/لون النيازك
        var sel = document.getElementById('s_BgEffect'); sel.value = '@Model.BgEffect';
        var fxShape = document.getElementById('s_FxShape'); fxShape.value = '@Model.FxShape';
        var fxCard = document.getElementById('fxCard');

        function buildFx() {
            var eff = sel.value, shape = fxShape.value;
            var count = parseInt(document.getElementById('r_FxCount').value, 10) || 14;
            var isParticles = (eff === 'meteors' || eff === 'bubbles');
            fxCard.style.display = isParticles ? '' : 'none';
            body.classList.toggle('fx-drift', eff === 'drift');
            var old = document.getElementById('bgFxPreview'); if (old) old.remove();
            if (isParticles) {
                var d = document.createElement('div');
                d.id = 'bgFxPreview'; d.className = 'bg-fx bg-fx-' + eff + ' fx-' + shape; d.setAttribute('aria-hidden', 'true');
                var html = '';
                for (var i = 0; i < count; i++) {
                    html += '<span class="meteor" style="left:' + ((i * 97 + 5) % 100) + '%;animation-delay:' + (i * 0.5) + 's"></span>';
                }
                d.innerHTML = html; body.appendChild(d);
            }
        }
        sel.addEventListener('change', buildFx);
        fxShape.addEventListener('change', buildFx);

        // لون النيازك
        var fxc = document.getElementById('c_FxColor'), fxt = document.getElementById('t_FxColor');
        function setFxColor() { fxt.value = fxc.value; root.style.setProperty('--fx-color', fxc.value); }
        fxc.addEventListener('input', setFxColor);
        fxt.addEventListener('change', function () { if (/^#[0-9a-fA-F]{6}$/.test(fxt.value)) { fxc.value = fxt.value; setFxColor(); } });

        // حجم/عدد/مدّة النيازك
        document.getElementById('r_FxSize').addEventListener('input', function () {
            document.getElementById('v_FxSize').textContent = this.value; root.style.setProperty('--fx-size', this.value + 'px');
        });
        document.getElementById('r_FxSpeed').addEventListener('input', function () {
            document.getElementById('v_FxSpeed').textContent = this.value; root.style.setProperty('--fx-dur', this.value + 's');
        });
        document.getElementById('r_FxCount').addEventListener('input', function () {
            document.getElementById('v_FxCount').textContent = this.value; buildFx();
        });

        // صورة الهيدر — رفع ملف مع معاينة حيّة
        var hdrUrl = document.getElementById('s_HeaderImageUrl');
        var hdrFile = document.getElementById('f_HeaderImage');
        var hdrPrev = document.getElementById('prev_Header');
        var hdrClear = document.getElementById('clearHeader');
        function setHeaderBg(u) {
            var tb = document.querySelector('.topbar'); if (!tb) return;
            if (u) {
                tb.style.backgroundImage = "linear-gradient(rgba(255,255,255,.55),rgba(255,255,255,.72)),url('" + u + "')";
                tb.style.backgroundSize = 'cover'; tb.style.backgroundPosition = 'center';
            } else { tb.style.backgroundImage = ''; }
        }
        if (hdrFile) hdrFile.addEventListener('change', function () {
            var f = this.files && this.files[0]; if (!f) return;
            var u = URL.createObjectURL(f);
            setHeaderBg(u);
            if (hdrPrev) { hdrPrev.src = u; hdrPrev.hidden = false; }
            if (hdrClear) hdrClear.checked = false;
        });
        if (hdrClear) hdrClear.addEventListener('change', function () {
            if (this.checked) {
                if (hdrFile) hdrFile.value = '';
                if (hdrUrl) hdrUrl.value = '';        // الخادم يمسح الصورة عند رابط فارغ
                if (hdrPrev) hdrPrev.hidden = true;
                setHeaderBg('');
            }
        });

        // الشعار — رفع ملف/استعادة الرسمي مع معاينة حيّة
        var embUrl = document.getElementById('s_EmblemImageUrl');
        var embFile = document.getElementById('f_EmblemImage');
        var embPrev = document.getElementById('prev_Emblem');
        var embRestore = document.getElementById('restoreEmblem');
        function setEmblemEverywhere(u) {
            if (embPrev) embPrev.src = u;
            document.querySelectorAll('img.oman-emblem-img').forEach(function (im) { im.src = u; });
        }
        if (embFile) embFile.addEventListener('change', function () {
            var f = this.files && this.files[0]; if (!f) return;
            var u = URL.createObjectURL(f);
            setEmblemEverywhere(u);
            if (embRestore) embRestore.checked = false;
        });
        if (embRestore) embRestore.addEventListener('change', function () {
            if (this.checked) {
                if (embFile) embFile.value = '';
                if (embUrl) embUrl.value = '/img/oman-emblem.svg';  // استعادة الرسمي
                setEmblemEverywhere('/img/oman-emblem.svg');
            }
        });

        // الوضع الوطني — معاينة حيّة: إظهار/إخفاء زينة الهوية الوطنية على الصفحة الحالية
        var natSw = document.getElementById('s_NationalMode');
        if (natSw) {
            natSw.addEventListener('change', function () {
                document.body.classList.toggle('nat-off', !this.checked);
                document.body.classList.toggle('nat-on', this.checked);
            });
        }

        buildFx();
    })();
</script>
}
