@model Auction
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "إنشاء مزاد";
    var crops = ViewBag.Crops as List<SelectListItem> ?? new();
    var farmers = ViewBag.Farmers as List<SelectListItem> ?? new();
    var brokerList = ViewBag.BrokerList as List<BrokerOption> ?? new();
    bool isBroker = User.IsInRole(Roles.Broker) || User.IsInRole(Roles.Admin);
    bool creatorIsBroker = User.IsInRole(Roles.Broker) && !User.IsInRole(Roles.Admin);
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card">
            <div class="card-header">إنشاء مزاد جديد</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label required"></label>
                            <input asp-for="Title" class="form-control" placeholder="مثال: طماطم درجة أولى — دفعة 8 أطنان" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CropId" class="form-label required"></label>
                            <select asp-for="CropId" class="form-select" id="cropSelect">
                                <option value="">— اختر المحصول —</option>
                                @foreach (var c in crops)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                                <option value="-1">➕ أخرى — إضافة محصول جديد</option>
                            </select>
                            <span asp-validation-for="CropId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4" id="newCropWrap" style="display:none">
                            <label class="form-label required">اسم المحصول الجديد</label>
                            <input name="newCropName" id="newCropName" class="form-control"
                                   value="@(ViewBag.NewCropName as string)" placeholder="اكتب اسم المحصول ثم أنشئ المزاد" />
                            @Html.ValidationMessage("newCropName", new { @class = "text-danger small" })
                            <div class="form-text">يُضاف المحصول للقائمة ويصبح متاحاً للجميع.</div>
                        </div>

                        @if (isBroker)
                        {
                            <div class="col-md-6">
                                <label class="form-label required">المزارع صاحب المحصول</label>
                                <select asp-for="FarmerId" class="form-select" asp-items="farmers">
                                    <option value="">— اختر المزارع —</option>
                                </select>
                                <span asp-validation-for="FarmerId" class="text-danger small"></span>
                                <div class="form-text">بإنشائك للمزاد تصبح الوسيط المشرف عليه ويُفتح للمزايدة مباشرة.</div>
                            </div>
                        }

                        @if (!creatorIsBroker)
                        {
                            <div class="col-md-6">
                                <label class="form-label required">نوع التفويض</label>
                                <select id="delegation" name="delegation" class="form-select">
                                    <option value="self">ذاتي — أدير المزاد بنفسي (الإلغاء والترسية بيدي)</option>
                                    <option value="broker">وسيط — أفوّض وسيطاً بإدارة المزاد</option>
                                </select>
                                <span asp-validation-for="BrokerId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6" id="brokerWrap" style="display:none">
                                <label class="form-label required">الوسيط المفوَّض</label>
                                <select asp-for="BrokerId" class="form-select">
                                    <option value="">— اختر الوسيط —</option>
                                    @foreach (var br in brokerList)
                                    {
                                        <option value="@br.Id" data-rate="@br.Rate.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            @br.Name — عمولة @br.Rate.ToString("0.##")%
                                        </option>
                                    }
                                </select>
                                <div class="form-text">تنتقل صلاحيات المزاد (الإلغاء والإدارة والترسية) إلى الوسيط المختار.</div>
                            </div>
                        }
                        else
                        {
                            <div class="col-12">
                                <div class="alert alert-light border small mb-0">
                                    بصفتك وسيطاً، أنت <strong>المشرف المفوَّض</strong> على هذا المزاد — الإلغاء والترسية بيدك.
                                </div>
                            </div>
                        }

                        <div class="col-md-3">
                            <label asp-for="Quantity" class="form-label required">الكمية</label>
                            <div class="input-group">
                                <input asp-for="Quantity" class="form-control" type="number" step="0.01" placeholder="مثال: 8" />
                                <span class="input-group-text">طن</span>
                            </div>
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                            <div class="form-text">أدخل الكمية <strong>بالطن</strong> (١ طن = ١٠٠٠ كجم).</div>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Quality" class="form-label"></label>
                            <select asp-for="Quality" class="form-select">
                                <option value="1">ممتاز</option>
                                <option value="2">درجة أولى</option>
                                <option value="3">درجة ثانية</option>
                                <option value="4">درجة ثالثة</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="StartPrice" class="form-label required">سعر الافتتاح للطن</label>
                            <div class="input-group">
                                <input asp-for="StartPrice" class="form-control" type="number" step="0.01" />
                                <span class="input-group-text">ر.ع / طن</span>
                            </div>
                            <span asp-validation-for="StartPrice" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="MinIncrement" class="form-label"></label>
                            <input asp-for="MinIncrement" class="form-control" type="number" step="0.01" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Type" class="form-label"></label>
                            <select asp-for="Type" class="form-select" id="auctionType">
                                <option value="1">لحظي — محصول جاهز أو قريب النضج</option>
                                <option value="2">مستقبلي — بيع مبكر قبل الزراعة/الحصاد</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" class="form-control" type="date" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="EndDate" class="form-label required"></label>
                            <input asp-for="EndDate" class="form-control" type="date" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4" id="harvestWrap">
                            <label asp-for="ExpectedHarvestDate" class="form-label"></label>
                            <input asp-for="ExpectedHarvestDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedHarvestDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PickupLocation" class="form-label"></label>
                            <input asp-for="PickupLocation" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Logistics" class="form-label"></label>
                            <select asp-for="Logistics" class="form-select">
                                <option value="1">على البائع (المزارع)</option>
                                <option value="2">على المشتري</option>
                                <option value="3">ينظمها الوسيط</option>
                                <option value="4">مزود خدمة خارجي</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="طريقة الفرز، نوع العبوات، جاهزية التحميل، أي شهادات جودة..."></textarea>
                        </div>
                    </div>

                    <!-- معاينة المزاد قبل النشر -->
                    <div class="card border-success mt-4" id="previewPanel">
                        <div class="card-header bg-light fw-bold d-flex align-items-center gap-2">
                            @Icons.Render("file-text", 16) معاينة المزاد قبل النشر
                        </div>
                        <div class="card-body">
                            <div class="row g-2 small mb-2">
                                <div class="col-md-4"><span class="text-muted">المحصول:</span> <b id="pvCrop">—</b></div>
                                <div class="col-md-4"><span class="text-muted">الكمية:</span> <b id="pvQty">—</b></div>
                                <div class="col-md-4"><span class="text-muted">الجودة:</span> <b id="pvQuality">—</b></div>
                                <div class="col-md-4"><span class="text-muted">النوع:</span> <b id="pvType">—</b></div>
                                <div class="col-md-4"><span class="text-muted">سعر الافتتاح/طن:</span> <b id="pvPrice">—</b></div>
                                <div class="col-md-4"><span class="text-muted">التفويض:</span> <b id="pvDelegation">ذاتي</b></div>
                            </div>
                            <hr class="my-2" />
                            <div class="row g-2 text-center">
                                <div class="col-6 col-md-3">
                                    <div class="text-muted small">القيمة التقديرية</div>
                                    <div class="fw-bold rtl-num" id="pvValue">0.00</div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="text-muted small">عمولة المنصة (<span id="pvPlatRate">—</span>)</div>
                                    <div class="fw-bold text-danger rtl-num" id="pvPlatform">0.00</div>
                                </div>
                                <div class="col-6 col-md-3" id="pvBrokerCol">
                                    <div class="text-muted small">عمولة الوسيط (<span id="pvBrokerRate">—</span>)</div>
                                    <div class="fw-bold text-warning rtl-num" id="pvBroker">0.00</div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="text-muted small">صافي للمزارع</div>
                                    <div class="fw-bold text-success rtl-num" id="pvNet">0.00</div>
                                </div>
                            </div>
                            <div class="form-text mt-2">
                                القيمة تقديرية بسعر الافتتاح؛ العمولة النهائية تُحتسب على سعر الترسية.
                                شرائح عمولة المنصة: @(ViewBag.PlatformTiers as string).
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-light border small mt-3 mb-0">
                        بند اللوجستيات يُوثّق في العقد الرقمي منذ الخطوة الأولى.
                        <strong>ساوم ليست مسؤولة عن النقل أو التخزين أو التأمين</strong>، ودورها التوثيق والضمان الرقمي فقط.
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-green px-4">نشر المزاد</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">إلغاء</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleHarvest() {
            var t = document.getElementById('auctionType').value;
            document.getElementById('harvestWrap').style.display = (t === '2') ? '' : 'none';
        }
        document.getElementById('auctionType').addEventListener('change', toggleHarvest);
        toggleHarvest();

        // إظهار حقل "محصول جديد" عند اختيار "أخرى"
        var cropSelect = document.getElementById('cropSelect');
        var newCropWrap = document.getElementById('newCropWrap');
        var newCropInput = document.getElementById('newCropName');
        function toggleNewCrop() {
            var other = cropSelect.value === '-1';
            newCropWrap.style.display = other ? '' : 'none';
            if (other) { newCropInput.focus(); } else { newCropInput.value = ''; }
        }
        cropSelect.addEventListener('change', toggleNewCrop);
        toggleNewCrop();   // يُظهره تلقائياً إن أُعيد عرض النموذج و"أخرى" مختارة

        // ── التفويض + معاينة المزاد الحيّة ──────────────────────────
        const creatorIsBroker = @(creatorIsBroker ? "true" : "false");
        const $ = id => document.getElementById(id);
        const num = v => { v = parseFloat(v); return isNaN(v) ? 0 : v; };
        const money = n => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const platRate = t => t <= 5 ? 25 : (t <= 10 ? 20 : 15);
        const selText = el => (el && el.selectedIndex >= 0) ? el.options[el.selectedIndex].text.trim() : '—';

        function toggleDelegation() {
            const d = $('delegation');
            if (!d) return;
            $('brokerWrap').style.display = (d.value === 'broker') ? '' : 'none';
            update();
        }

        function update() {
            const qty = num($('Quantity') && $('Quantity').value);
            const price = num($('StartPrice') && $('StartPrice').value);
            const value = qty * price;
            const pr = platRate(qty);
            const platform = value * pr / 100;

            let brokerRate = 0, brokerAmt = 0, deleg = 'ذاتي';
            const d = $('delegation');
            const brokerMode = d ? (d.value === 'broker') : creatorIsBroker;
            const bsel = document.querySelector('[name="BrokerId"]');
            if (brokerMode && bsel && bsel.value) {
                const opt = bsel.options[bsel.selectedIndex];
                brokerRate = num(opt.getAttribute('data-rate'));
                brokerAmt = value * brokerRate / 100;
                deleg = 'وسيط: ' + opt.text.trim();
            } else if (brokerMode) {
                deleg = creatorIsBroker ? 'وسيط (أنت)' : 'وسيط (لم يُختر بعد)';
            }

            const cs = $('cropSelect');
            $('pvCrop').textContent = (cs && cs.selectedIndex > 0 && cs.value !== '-1') ? selText(cs)
                                     : (($('newCropName') && $('newCropName').value) || '—');
            $('pvQty').textContent = qty ? (qty + ' طن') : '—';
            $('pvQuality').textContent = selText($('Quality'));
            $('pvType').textContent = selText($('auctionType'));
            $('pvPrice').textContent = price ? (money(price) + ' ر.ع') : '—';
            $('pvDelegation').textContent = deleg;

            $('pvValue').textContent = money(value);
            $('pvPlatRate').textContent = pr + '%';
            $('pvPlatform').textContent = money(platform);
            $('pvBrokerRate').textContent = brokerRate ? (brokerRate + '%') : '—';
            $('pvBroker').textContent = money(brokerAmt);
            $('pvBrokerCol').style.opacity = brokerAmt > 0 ? '1' : '.5';
            $('pvNet').textContent = money(value - platform - brokerAmt);
        }

        if ($('delegation')) $('delegation').addEventListener('change', toggleDelegation);
        ['Quantity', 'StartPrice', 'Quality', 'auctionType', 'cropSelect', 'newCropName'].forEach(function (id) {
            const el = $(id); if (el) { el.addEventListener('input', update); el.addEventListener('change', update); }
        });
        const bsel0 = document.querySelector('[name="BrokerId"]');
        if (bsel0) bsel0.addEventListener('change', update);
        toggleDelegation();
        update();
    </script>
}
