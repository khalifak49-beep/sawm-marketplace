@model PlaceBidViewModel
@{
    ViewData["Title"] = "تقديم مزايدة";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">تقديم مزايدة</div>
            <div class="card-body">
                <h6 class="fw-bold mb-3">@Model.AuctionTitle</h6>

                <div class="row g-3 mb-4">
                    <div class="col-4">
                        <div class="stat-card text-center">
                            <div class="stat-value rtl-num">@Model.CurrentPrice.ToString("N2")</div>
                            <div class="stat-label">السعر الحالي</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-card text-center">
                            <div class="stat-value rtl-num">@Model.MinIncrement.ToString("N2")</div>
                            <div class="stat-label">أقل زيادة</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-card text-center">
                            <div class="stat-value rtl-num">@Model.Quantity.ToString("N0")</div>
                            <div class="stat-label">الكمية (@Model.Unit)</div>
                        </div>
                    </div>
                </div>

                <form asp-action="Bid" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AuctionId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="UnitPrice" class="form-label required"></label>
                        <input asp-for="UnitPrice" class="form-control form-control-lg" type="number" step="0.01" id="unitPrice" />
                        <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                        <div class="form-text">
                            القيمة الكلية التقديرية: <strong class="rtl-num" id="totalPreview">—</strong> ر.ع
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="2"
                                  placeholder="شروط التسليم، عدد الدفعات، أي ملاحظات للمزارع..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-green px-4">تأكيد المزايدة</button>
                        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.AuctionId">رجوع</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var qty = @Model.Quantity;
        var input = document.getElementById('unitPrice');
        var out = document.getElementById('totalPreview');
        function update() {
            var v = parseFloat(input.value);
            out.textContent = isNaN(v) ? '—' : (v * qty).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        input.addEventListener('input', update);
        update();
    </script>
}
