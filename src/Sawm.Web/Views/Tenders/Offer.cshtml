@model SubmitOfferViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "تقديم عرض";
    var farmers = ViewBag.Farmers as List<SelectListItem> ?? new();
    bool isBroker = User.IsInRole(Roles.Broker);
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">تقديم عرض على مناقصة</div>
            <div class="card-body">
                <h6 class="fw-bold mb-3">@Model.TenderTitle</h6>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="stat-card text-center">
                            <div class="stat-value rtl-num">@Model.RequiredQuantity.ToString("N0")</div>
                            <div class="stat-label">الكمية المطلوبة (@Model.Unit)</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-card text-center">
                            <div class="stat-value rtl-num">@Model.MaxUnitPrice.ToString("N2")</div>
                            <div class="stat-label">السقف السعري للوحدة</div>
                        </div>
                    </div>
                </div>

                <form asp-action="Offer" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="TenderId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    @if (isBroker)
                    {
                        <div class="mb-3">
                            <label asp-for="RepresentedFarmerId" class="form-label required"></label>
                            <select asp-for="RepresentedFarmerId" class="form-select" asp-items="farmers">
                                <option value="">— اختر المزارع —</option>
                            </select>
                            <span asp-validation-for="RepresentedFarmerId" class="text-danger small"></span>
                            <div class="form-text">سيُسجَّل العرض باسم المزارع مع إثبات تمثيلك له، وتُحتسب عمولتك عند الترسية.</div>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="UnitPrice" class="form-label required"></label>
                            <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" id="unitPrice" />
                            <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AvailableQuantity" class="form-label required"></label>
                            <input asp-for="AvailableQuantity" class="form-control" type="number" step="0.01" id="qty" />
                            <span asp-validation-for="AvailableQuantity" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EarliestDelivery" class="form-label"></label>
                            <input asp-for="EarliestDelivery" class="form-control" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">القيمة الإجمالية للعرض</label>
                            <div class="form-control bg-light rtl-num fw-bold" id="totalPreview">—</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"
                                      placeholder="جدول التوريد، الشهادات المتوفرة، مبررات السعر..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-green px-4">إرسال العرض</button>
                        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.TenderId">رجوع</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var p = document.getElementById('unitPrice');
        var q = document.getElementById('qty');
        var out = document.getElementById('totalPreview');
        function update() {
            var a = parseFloat(p.value), b = parseFloat(q.value);
            out.textContent = (isNaN(a) || isNaN(b)) ? '—'
                : (a * b).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ر.ع';
        }
        p.addEventListener('input', update);
        q.addEventListener('input', update);
        update();
    </script>
}
