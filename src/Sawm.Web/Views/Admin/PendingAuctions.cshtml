@model List<Auction>
@{
    ViewData["Title"] = "اعتماد المزادات";
}

<div class="mb-3">
    <h5 class="fw-bold mb-1">طابور اعتماد المزادات</h5>
    <div class="muted-label">دقّق تفاصيل كل مزاد وعدّلها إن لزم، ثم اعتمده لفتحه للمزايدة أو ارفضه.</div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>المزاد</th><th>المزارع</th><th>الوسيط</th><th>المحصول</th>
                    <th>الكمية</th><th>سعر الافتتاح</th><th>يغلق في</th><th>إجراءات التدقيق</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="8">
                    <div class="empty-state">
                        <span class="ico">@Icons.Render("check-circle", 22)</span>
                        لا توجد مزادات بانتظار الاعتماد.
                    </div>
                </td></tr>
            }
            @foreach (var a in Model)
            {
                <tr>
                    <td class="fw-semibold small">@a.Title<div class="muted-label">@Display.AuctionType(a.Type)</div></td>
                    <td class="small">@a.Farmer?.FullName<div class="muted-label">@a.Farmer?.Region</div></td>
                    <td class="small">@(a.Broker?.FullName ?? "—")</td>
                    <td class="small">@a.Crop?.Name</td>
                    <td class="rtl-num small">@a.Quantity.ToString("N0") @a.DisplayUnit</td>
                    <td class="rtl-num small">@a.StartPrice.ToString("N2")</td>
                    <td class="rtl-num small">@a.EndDate.ToString("yyyy/MM/dd")</td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Auctions" asp-action="Edit" asp-route-id="@a.Id">
                            @Icons.Render("note", 14) تعديل
                        </a>
                        <form asp-controller="Auctions" asp-action="Approve" method="post" class="d-inline"
                              onsubmit="return confirm('اعتماد المزاد وفتحه للمزايدة؟');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" />
                            <button class="btn btn-sm btn-green">اعتماد</button>
                        </form>
                        <button class="btn btn-sm btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#rej-@a.Id">رفض</button>
                    </td>
                </tr>
                <tr class="collapse" id="rej-@a.Id">
                    <td colspan="8" class="bg-light">
                        <form asp-controller="Auctions" asp-action="Reject" method="post" class="d-flex gap-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" />
                            <input name="reason" class="form-control form-control-sm" placeholder="سبب الرفض (يظهر للمزارع)" style="max-width:420px" />
                            <button class="btn btn-sm btn-danger">تأكيد الرفض</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
