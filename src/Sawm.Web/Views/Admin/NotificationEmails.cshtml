@model List<NotificationEmail>
@{
    ViewData["Title"] = "مستلمو الإشعارات";
    bool configured = ViewBag.EmailConfigured ?? false;
}

<h5 class="fw-bold mb-1">مستلمو الإشعارات بالبريد</h5>
<p class="text-muted small mb-3">العناوين المضافة هنا تصلها نسخة من <strong>كل</strong> إشعارات المنصة (مزادات، مزايدات، عقود، مناقصات...).</p>

@if (!configured)
{
    <div class="alert alert-warning d-flex align-items-center gap-2">
        @Icons.Render("alert", 18)
        <div>
            إعدادات SMTP غير مكتملة — لن تُرسَل الرسائل حتى تُضبط كلمة مرور البريد في متغيّرات البيئة
            (<code dir="ltr">Email__Password</code>).
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">إضافة مستلمين</div>
            <div class="card-body">
                <form asp-action="AddNotificationEmail" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label required">البريد الإلكتروني</label>
                        <textarea name="emails" rows="4" class="form-control" dir="ltr" required
                                  placeholder="name@example.com&#10;ops@company.com&#10;manager@company.com"></textarea>
                        <div class="form-text">يمكنك إضافة أكثر من بريد — سطر لكل بريد أو مفصولة بفاصلة.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">وصف (اختياري)</label>
                        <input name="label" class="form-control" placeholder="مثلاً: إدارة العمليات" />
                    </div>
                    <button class="btn btn-green w-100">@Icons.Render("plus", 16) إضافة</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">اختبار البريد</div>
            <div class="card-body">
                <form asp-action="SendTestEmail" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">أرسل رسالة اختبار إلى</label>
                        <input name="email" type="email" class="form-control" dir="ltr" required placeholder="name@example.com" />
                    </div>
                    <button class="btn btn-outline-success w-100">@Icons.Render("send", 16) إرسال اختبار</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">القائمة (@Model.Count)</div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead><tr><th>البريد</th><th>الوصف</th><th>الحالة</th><th>أُضيف</th><th>إجراءات</th></tr></thead>
                    <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-5">لا يوجد مستلمون بعد.</td></tr>
                    }
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="small fw-semibold" dir="ltr">@e.Email</td>
                            <td class="small">@(e.Label ?? "—")</td>
                            <td>
                                <span class="badge bg-@(e.IsActive ? "success" : "secondary")">@(e.IsActive ? "نشط" : "موقوف")</span>
                            </td>
                            <td class="small rtl-num">@e.CreatedAt.ToString("yyyy/MM/dd")</td>
                            <td class="text-nowrap">
                                <form asp-action="ToggleNotificationEmail" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@e.Id" />
                                    <button class="btn btn-sm btn-outline-secondary">@(e.IsActive ? "إيقاف" : "تفعيل")</button>
                                </form>
                                <form asp-action="DeleteNotificationEmail" method="post" class="d-inline"
                                      onsubmit="return confirm('حذف هذا المستلم؟');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@e.Id" />
                                    <button class="btn btn-sm btn-outline-danger" title="حذف">@Icons.Render("trash", 14)</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
