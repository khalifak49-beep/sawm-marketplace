@model ApplicationUser
@{
    ViewData["Title"] = "ملفي الشخصي";
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body text-center">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                     style="width:78px;height:78px;background:#1f6f43;color:#fff;font-size:2rem;font-weight:700;">
                    @Model.FullName.Trim().FirstOrDefault()
                </div>
                <h6 class="fw-bold mb-1">@Model.FullName</h6>
                <span class="role-chip">@Display.UserType(Model.UserType)</span>
                <div class="mt-3 small text-muted">
                    <div class="rtl-num">@Model.Email</div>
                    <div class="rtl-num">@Model.PhoneNumber</div>
                    <div>@Model.Region</div>
                </div>
                <hr />
                <div class="d-flex justify-content-around">
                    <div>
                        <div class="fw-bold text-warning">@Icons.Render("star", 13) @Model.RatingAverage.ToString("N1")</div>
                        <div class="muted-label">التقييم</div>
                    </div>
                    <div>
                        <div class="fw-bold">@Model.RatingCount</div>
                        <div class="muted-label">عدد التقييمات</div>
                    </div>
                    <div>
                        <div class="fw-bold">@(Model.IsVerified ? "✔" : "—")</div>
                        <div class="muted-label">التوثيق</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">تعديل البيانات</div>
            <div class="card-body">
                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">الاسم الكامل</label>
                            <input name="fullName" class="form-control" value="@Model.FullName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">المحافظة / المنطقة</label>
                            <input name="region" class="form-control" value="@Model.Region" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">العنوان</label>
                            <input name="address" class="form-control" value="@Model.Address" />
                        </div>
                    </div>

                    @if (Model.UserType == UserType.Farmer)
                    {
                        <hr class="my-4" />
                        <h6 class="fw-bold mb-3">بيانات المزرعة</h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">المساحة (فدان)</label>
                                <input name="farmArea" type="number" step="0.1" class="form-control" value="@(Model.FarmerProfile?.FarmArea ?? 0)" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">نوع التربة</label>
                                <input name="soilType" class="form-control" value="@Model.FarmerProfile?.SoilType" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">مصدر الري</label>
                                <input name="irrigationSource" class="form-control" value="@Model.FarmerProfile?.IrrigationSource" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">سنوات الخبرة</label>
                                <input name="experienceYears" type="number" class="form-control" value="@(Model.FarmerProfile?.ExperienceYears ?? 0)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">موقع المزرعة</label>
                                <input name="farmLocation" class="form-control" value="@Model.FarmerProfile?.FarmLocation" />
                            </div>
                        </div>
                    }
                    else if (Model.UserType == UserType.Broker)
                    {
                        <hr class="my-4" />
                        <h6 class="fw-bold mb-3">بيانات الوساطة</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">رقم الترخيص</label>
                                <input name="licenseNumber" class="form-control" value="@Model.BrokerProfile?.LicenseNumber" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">نسبة العمولة %</label>
                                <input name="commissionRate" type="number" step="0.1" min="0" max="30" class="form-control" value="@(Model.BrokerProfile?.CommissionRate ?? 2.5m)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">نطاق التغطية</label>
                                <input name="coverageArea" class="form-control" value="@Model.BrokerProfile?.CoverageArea" />
                            </div>
                        </div>
                        <div class="alert alert-light border mt-3 small mb-0">
                            صفقات منجزة: <strong>@(Model.BrokerProfile?.ClosedDeals ?? 0)</strong> —
                            تُحتسب العمولة تلقائياً على كل عقد تشرف عليه.
                        </div>
                    }
                    else if (Model.UserType == UserType.Company)
                    {
                        <hr class="my-4" />
                        <h6 class="fw-bold mb-3">بيانات الشركة</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">اسم الشركة</label>
                                <input name="companyName" class="form-control" value="@Model.CompanyProfile?.CompanyName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">السجل التجاري</label>
                                <input name="commercialRegistry" class="form-control" value="@Model.CompanyProfile?.CommercialRegistry" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">طبيعة النشاط</label>
                                <input name="activityType" class="form-control" value="@Model.CompanyProfile?.ActivityType" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">الطلب الشهري المتوقع (طن)</label>
                                <input name="monthlyDemand" type="number" step="0.1" class="form-control" value="@(Model.CompanyProfile?.MonthlyDemand ?? 0)" />
                            </div>
                        </div>
                    }

                    <button type="submit" class="btn btn-green mt-4">حفظ التغييرات</button>
                </form>
            </div>
        </div>
    </div>
</div>
