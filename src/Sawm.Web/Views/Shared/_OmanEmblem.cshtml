@using Sawm.Web.Services
@inject ThemeService Theme
@{
    var th = await Theme.GetAsync();
}
@if (!string.IsNullOrWhiteSpace(th.EmblemImageUrl))
{
    var isOfficial = th.EmblemImageUrl!.StartsWith("/img/oman-emblem.svg", StringComparison.OrdinalIgnoreCase);
    <img class="oman-emblem oman-emblem-img @(isOfficial ? "oman-emblem-official" : "")" src="@th.EmblemImageUrl" alt="شعار سلطنة عُمان" loading="lazy" />
}
else
{
    @* شعار سلطنة عُمان (الخنجر والسيفان) — رسم خطّي مبسّط أحادي اللون *@
    <svg class="oman-emblem" viewBox="0 0 100 112" fill="none" stroke="currentColor"
         stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"
         xmlns="http://www.w3.org/2000/svg" role="img" aria-label="شعار سلطنة عُمان">
        <!-- السيف الأول (من أعلى اليسار إلى أسفل اليمين) -->
        <path d="M12 20 L64 78" />
        <path d="M16 16 L68 74" />
        <path d="M12 20 L16 16" />                       <!-- طرف النصل -->
        <circle cx="12.5" cy="16.5" r="2.4" fill="currentColor" stroke="none" />
        <path d="M64 78 l7 7 M68 74 l7 7" />             <!-- المقبض -->
        <!-- السيف الثاني (من أعلى اليمين إلى أسفل اليسار) -->
        <path d="M88 20 L36 78" />
        <path d="M84 16 L32 74" />
        <path d="M88 20 L84 16" />
        <circle cx="87.5" cy="16.5" r="2.4" fill="currentColor" stroke="none" />
        <path d="M36 78 l-7 7 M32 74 l-7 7" />
        <!-- الحزام (القِطان) مع لوحتين جانبيتين وحلقتين -->
        <rect x="30" y="52" width="40" height="9" rx="2.5" />
        <rect x="14" y="53" width="14" height="7" rx="2" />
        <rect x="72" y="53" width="14" height="7" rx="2" />
        <circle cx="40" cy="56.5" r="2.3" />
        <circle cx="60" cy="56.5" r="2.3" />
        <!-- الخنجر: مقبض بمقبض علوي (T) ثم غمد منحنٍ لأسفل -->
        <path d="M43 30 h14" stroke-width="3" />          <!-- رأس المقبض -->
        <path d="M46 30 v9 h8 v-9" />
        <path d="M45 39 h10 v13 h-10 z" />               <!-- بدن المقبض -->
        <path d="M44 61 C 40 76, 45 90, 58 96 C 66 88, 60 74, 56 63" />  <!-- الغمد المنحني -->
    </svg>
}
