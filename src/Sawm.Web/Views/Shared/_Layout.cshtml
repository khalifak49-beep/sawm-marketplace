@using Microsoft.EntityFrameworkCore
@using Sawm.Web.Data
@using Sawm.Web.Services
@inject SawmDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject ThemeService Theme
@{
    var theme = await Theme.GetAsync();
    var themeCss = ThemeService.BuildCss(theme);
    var uid = UserManager.GetUserId(User);
    var signedIn = User.Identity?.IsAuthenticated == true && uid != null;

    var unread = 0;
    ApplicationUser? me = null;
    var liveAuctions = 0;
    var openTenders = 0;
    var isParentCompany = false;   // شركة رئيسية (ليست فرعاً) → تدير الفروع
    var branchApprovals = 0;       // مزايدات فروع تنتظر موافقة الرئيسية
    var pendingAuctions = 0;       // مزادات تنتظر اعتماد الإدارة

    if (signedIn)
    {
        unread = await Db.Notifications.CountAsync(n => n.UserId == uid && !n.IsRead);
        me = await Db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == uid);
        liveAuctions = await Db.Auctions.CountAsync(a => a.Status == AuctionStatus.Active && a.EndDate > DateTime.Now);
        openTenders = await Db.Tenders.CountAsync(t => t.Status == TenderStatus.Open && t.ClosingDate > DateTime.Now);

        if (User.IsInRole(Roles.Admin))
            pendingAuctions = await Db.Auctions.CountAsync(a => a.Status == AuctionStatus.Pending);

        if (me?.UserType == UserType.Company)
        {
            var cp = await Db.CompanyProfiles.AsNoTracking().FirstOrDefaultAsync(p => p.UserId == uid);
            isParentCompany = cp is { ParentCompanyId: null };
            if (isParentCompany)
                branchApprovals = await Db.Bids.CountAsync(b => b.Status == BidStatus.PendingApproval
                    && Db.CompanyProfiles.Any(p => p.UserId == b.BidderId && p.ParentCompanyId == uid));
        }
    }

    var ctl = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var act = (ViewContext.RouteData.Values["action"] as string) ?? "";
    string On(string c) => string.Equals(ctl, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string OnAction(string c, string a) =>
        string.Equals(ctl, c, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(act, a, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15803D" />
    <title>@ViewData["Title"] — منصة ساوم</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style id="themeVars">@Html.Raw(themeCss)</style>
    <noscript>
        <!-- بدون جافاسكربت لا تُرفع ستارة الانتقال — أخفِها كي لا تحجب الصفحة -->
        <style>#pageFade { display: none !important; }</style>
    </noscript>
</head>
<body class="@(theme.BgEffect == "drift" ? "fx-drift " : "")@(theme.NationalMode ? "nat-on" : "nat-off")">
<!-- شريط علم عُمان (هوية وطنية على كل الصفحات) -->
<div class="oman-topstrip" aria-hidden="true"></div>
<!-- ستارة الانتقال بين الشاشات — تُرفع فور تحميل الصفحة -->
<div id="pageFade" aria-hidden="true"><span class="pf-mark">س</span></div>

@if (theme.BgEffect == "meteors" || theme.BgEffect == "bubbles")
{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    <div class="bg-fx bg-fx-@theme.BgEffect fx-@theme.FxShape" aria-hidden="true">
        @for (var i = 0; i < theme.FxCount; i++)
        {
            var left = (i * 97 + 5) % 100;
            var delay = (i * (theme.FxSpeed / (double)theme.FxCount)).ToString("0.##", inv);
            var dur = (theme.FxSpeed * (0.7 + (i % 5) * 0.12)).ToString("0.##", inv);
            <span class="meteor" style="left:@(left)%; animation-delay:@(delay)s; animation-duration:@(dur)s"></span>
        }
    </div>
}

@if (signedIn)
{
    <div class="app">
        <!-- ── الشريط الجانبي ──────────────────────────────── -->
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">س</span>
                <span class="brand-text"><b>ساوم</b><span>سوق المحاصيل الذكي</span></span>
                <span class="brand-emblem"><partial name="_OmanEmblem" /></span>
            </a>

            <nav aria-label="التنقل الرئيسي">
                <div class="nav-section">المنصة</div>
                <a class="nav-link-s @OnAction("Home","Index")" asp-controller="Home" asp-action="Index">
                    @Icons.Render("dashboard") <span>لوحة التحكم</span>
                </a>
                <a class="nav-link-s @On("Auctions")" asp-controller="Auctions" asp-action="Index">
                    @Icons.Render("gavel") <span>المزادات</span>
                    @if (liveAuctions > 0) { <span class="count rtl-num">@liveAuctions</span> }
                </a>
                <a class="nav-link-s @On("Tenders")" asp-controller="Tenders" asp-action="Index">
                    @Icons.Render("clipboard") <span>المناقصات</span>
                    @if (openTenders > 0) { <span class="count rtl-num">@openTenders</span> }
                </a>
                <a class="nav-link-s @On("Contracts")" asp-controller="Contracts" asp-action="Index">
                    @Icons.Render("file-text") <span>العقود</span>
                </a>

                @if (isParentCompany)
                {
                    <div class="nav-section">إدارة الشركة</div>
                    <a class="nav-link-s @OnAction("Company","Branches")" asp-controller="Company" asp-action="Branches">
                        @Icons.Render("building") <span>الفروع</span>
                    </a>
                    <a class="nav-link-s @OnAction("Company","Activity")" asp-controller="Company" asp-action="Activity">
                        @Icons.Render("gavel") <span>نشاط الفروع</span>
                        @if (branchApprovals > 0) { <span class="count rtl-num">@branchApprovals</span> }
                    </a>
                }

                @if (User.IsInRole(Roles.Broker) || User.IsInRole(Roles.Admin))
                {
                    <div class="nav-section">مساحة الوسيط</div>
                    <a class="nav-link-s @OnAction("Broker","Workspace")" asp-controller="Broker" asp-action="Workspace">
                        @Icons.Render("handshake") <span>لوحة الوسيط</span>
                    </a>
                    <a class="nav-link-s @OnAction("Broker","Farmers")" asp-controller="Broker" asp-action="Farmers">
                        @Icons.Render("wheat") <span>دليل المزارعين</span>
                    </a>
                    <a class="nav-link-s @OnAction("Broker","Companies")" asp-controller="Broker" asp-action="Companies">
                        @Icons.Render("building") <span>دليل الشركات</span>
                    </a>
                }

                @if (User.IsInRole(Roles.Admin))
                {
                    <div class="nav-section">الإدارة</div>
                    <a class="nav-link-s @OnAction("Admin","Index")" asp-controller="Admin" asp-action="Index">
                        @Icons.Render("chart") <span>لوحة الإدارة</span>
                    </a>
                    <a class="nav-link-s @OnAction("Admin","PendingAuctions")" asp-controller="Admin" asp-action="PendingAuctions">
                        @Icons.Render("gavel") <span>اعتماد المزادات</span>
                        @if (pendingAuctions > 0) { <span class="count rtl-num">@pendingAuctions</span> }
                    </a>
                    <a class="nav-link-s @OnAction("Admin","Users")" asp-controller="Admin" asp-action="Users">
                        @Icons.Render("users") <span>المستخدمون</span>
                    </a>
                    <a class="nav-link-s @OnAction("Admin","Crops")" asp-controller="Admin" asp-action="Crops">
                        @Icons.Render("seedling") <span>المحاصيل</span>
                    </a>
                    <a class="nav-link-s @OnAction("Admin","Reports")" asp-controller="Admin" asp-action="Reports">
                        @Icons.Render("trending-up") <span>التقارير</span>
                    </a>
                    <a class="nav-link-s @OnAction("Admin","NotificationEmails")" asp-controller="Admin" asp-action="NotificationEmails">
                        @Icons.Render("mail") <span>مستلمو الإشعارات</span>
                    </a>
                    <a class="nav-link-s @On("Theme")" asp-controller="Theme" asp-action="Index">
                        @Icons.Render("settings") <span>استوديو المظهر</span>
                    </a>
                    <a class="nav-link-s @On("ApiKeys")" asp-controller="ApiKeys" asp-action="Index">
                        @Icons.Render("key") <span>ربط الأنظمة (API)</span>
                    </a>
                }
            </nav>

            <div class="sidebar-foot">
                <div class="nat-badge mb-2">
                    <partial name="_OmanEmblem" />
                    <span><b>سلطنة عُمان</b><br><span>منصة وطنية</span></span>
                </div>
                <div class="flag-strip"><partial name="_OmanFlag" /></div>
                <div class="mt-2">المنصة تربط وتوثّق وتضمن رقمياً فقط — ولا تتحمل مسؤولية النقل أو التخزين أو التأمين.</div>
            </div>
        </aside>

        <div class="main-col">
            <!-- ── الشريط العلوي ────────────────────────────── -->
            <header class="topbar">
                <button class="icon-btn sidebar-toggle d-lg-none" id="navToggle"
                        aria-label="فتح قائمة التنقل" aria-expanded="false" aria-controls="sidebar">
                    @Icons.Render("menu")
                </button>

                <div>
                    <h1 class="page-title">@ViewData["Title"]</h1>
                    @if (ViewData["Subtitle"] is string sub)
                    {
                        <div class="page-sub">@sub</div>
                    }
                </div>

                <!-- علم عُمان الانسيابي داخل الهيدر -->
                <div class="topbar-flag d-none d-md-block"><partial name="_OmanFlag" /></div>

                <a class="icon-btn" asp-controller="Notifications" asp-action="Index"
                   aria-label="الإشعارات@(unread > 0 ? $" — {unread} غير مقروء" : "")">
                    @Icons.Render("bell")
                    <span class="notif-dot rtl-num" id="notifDot" data-count="@unread" style="@(unread > 0 ? "" : "display:none")">@unread</span>
                </a>

                <div class="dropdown">
                    <button class="btn btn-sm d-flex align-items-center gap-2 border-0" data-bs-toggle="dropdown"
                            aria-expanded="false" aria-label="قائمة الحساب">
                        <span class="avatar">@me?.FullName.Trim().FirstOrDefault()</span>
                        <span class="d-none d-md-block text-end lh-sm">
                            <span class="d-block fw-semibold" style="font-size:.85rem">@me?.FullName</span>
                            <span class="muted-label">@Display.UserType(me?.UserType ?? UserType.Farmer)</span>
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-start shadow">
                        @if (me is { RatingCount: > 0 })
                        {
                            <li class="dropdown-header d-flex align-items-center gap-1">
                                @Icons.Render("star", 14) <span class="rtl-num">@me.RatingAverage.ToString("N1")</span>
                                <span class="muted-label">(@me.RatingCount تقييم)</span>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                        }
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Account" asp-action="Profile">
                                @Icons.Render("user", 16) ملفي الشخصي
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 pb-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2">
                                    @Icons.Render("logout", 16) تسجيل الخروج
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </header>

            <main class="content">
                <partial name="_Flash" />
                @RenderBody()
            </main>

            <footer class="footer-note d-flex flex-wrap justify-content-between gap-2">
                <span>منصة ساوم — نظام بيئي رقمي يربط المزارع بالوسيط والشركة.</span>
                <span class="rtl-num">© @DateTime.Now.Year</span>
            </footer>
        </div>
    </div>
}
else
{
    <!-- ── الهيدر الحكومي (أبيض + علم انسيابي + شعار) ───────────── -->
    <header class="gov-header sticky-top">
      <nav class="navbar navbar-expand-lg p-0">
        <div class="container gov-header-in">
            <a class="gov-brand" asp-controller="Home" asp-action="Index">
                <span class="gov-emblem-mark"><partial name="_OmanEmblem" /></span>
                <span class="gov-brand-txt"><b>منصة ساوم</b><span>سوق المحاصيل الذكي</span></span>
            </a>
            <div class="gov-header-flag d-none d-lg-block" aria-hidden="true"><partial name="_OmanFlag" /></div>
            <button class="navbar-toggler gov-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#guestNav" aria-label="القائمة">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse gov-navwrap" id="guestNav">
                <nav class="gov-nav">
                    <a class="@On("Home")" asp-controller="Home" asp-action="Index">الرئيسية</a>
                    <a class="@On("Auctions")" asp-controller="Auctions" asp-action="Index">المزادات</a>
                    <a class="@On("Tenders")" asp-controller="Tenders" asp-action="Index">المناقصات</a>
                </nav>
                <div class="gov-actions">
                    <a class="btn btn-outline-success btn-sm" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                    <a class="btn btn-green btn-sm" asp-controller="Account" asp-action="Register">إنشاء حساب</a>
                </div>
            </div>
        </div>
      </nav>
    </header>

    <main class="container py-4">
        <partial name="_Flash" />
        @RenderBody()
    </main>

    <!-- ── الفوتر الحكومي (داكن + شعار + علم + روابط) ───────────── -->
    <footer class="gov-footer">
        <div class="container gov-footer-in">
            <div class="gf-about">
                <div class="gf-emblem"><partial name="_OmanEmblem" /></div>
                <b>معاً نحو مستقبل رقمي أفضل</b>
                <p>منصة وطنية تربط المزارع بالوسيط والشركة، وتوثّق وتضمن التداول رقمياً.</p>
            </div>
            <div class="gf-links">
                <span class="gf-h">روابط</span>
                <a asp-controller="Home" asp-action="Index">الرئيسية</a>
                <a asp-controller="Auctions" asp-action="Index">المزادات</a>
                <a asp-controller="Tenders" asp-action="Index">المناقصات</a>
                <a asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
            </div>
            <div class="gf-links">
                <span class="gf-h">تواصل</span>
                <a href="mailto:service@althiqaom.com">البريد الإلكتروني</a>
                <a asp-controller="Account" asp-action="Register">إنشاء حساب</a>
            </div>
        </div>
        <div class="gov-footer-flag" aria-hidden="true"><partial name="_OmanFlag" /></div>
        <div class="gov-footer-bottom">
            <div class="container d-flex flex-wrap justify-content-between gap-2">
                <span>جميع الحقوق محفوظة — منصة ساوم</span>
                <span class="rtl-num">© @DateTime.Now.Year</span>
            </div>
        </div>
    </footer>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/gsap/gsap.min.js"></script>
<script src="~/lib/gsap/ScrollTrigger.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
<script src="~/js/motion.js" asp-append-version="true"></script>
<script src="~/js/ui-confirm.js" asp-append-version="true"></script>
<script src="~/lib/signalr/signalr.min.js"></script>
<script src="~/js/live.js" asp-append-version="true"></script>
</body>
</html>
