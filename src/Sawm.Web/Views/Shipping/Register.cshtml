@{
    Layout = "~/Views/Shipping/_ShippingLayout.cshtml";
    ViewData["Title"] = "سجّل كناقل";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="lg-card p-4 p-lg-5">
            <div class="mb-4">
                <h5 class="fw-bold mb-1" style="color:#0b3b46;">تسجيل شركة نقل / ناقل</h5>
                <p class="text-muted small mb-0">أنشئ حسابك في منصة الشحن اللوجستي — مستقل تماماً عن حسابات منصة ساوم.</p>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold required">اسم شركة النقل</label>
                    <input class="form-control" placeholder="مثلاً: أسطول الخليج للنقل المبرّد" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold required">الشخص المسؤول</label>
                    <input class="form-control" placeholder="الاسم الكامل" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold required">البريد الإلكتروني</label>
                    <input class="form-control" dir="ltr" placeholder="carrier@example.com" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold required">رقم التواصل (واتساب)</label>
                    <input class="form-control" dir="ltr" placeholder="968XXXXXXXX" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">حجم الأسطول</label>
                    <input class="form-control" type="number" placeholder="عدد المركبات" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">نوع المركبات</label>
                    <input class="form-control" list="vtypes" placeholder="اختر النوع" />
                    <datalist id="vtypes">
                        <option value="شاحنات مبرّدة"></option><option value="شاحنات جافة"></option>
                        <option value="نقل ثقيل"></option><option value="نقل خفيف / توصيل"></option>
                    </datalist>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">مناطق التغطية</label>
                    <input class="form-control" list="regions" placeholder="المحافظات" />
                    <datalist id="regions">
                        <option value="مسقط"></option><option value="الباطنة"></option><option value="الداخلية"></option>
                        <option value="ظفار"></option><option value="الشرقية"></option><option value="كل المحافظات"></option>
                    </datalist>
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">نبذة عن الخدمة (اختياري)</label>
                    <textarea class="form-control" rows="2" placeholder="سلسلة تبريد متصلة، تتبّع مباشر، تأمين على الشحنة..."></textarea>
                </div>
            </div>

            <a class="lg-btn lg-btn-primary w-100 justify-content-center mt-4" asp-controller="Shipping" asp-action="Dashboard">إنشاء حساب ناقل</a>

            <div class="text-center small text-muted mt-3">
                لديك حساب؟ <a asp-controller="Shipping" asp-action="Login" style="color:#0e7490;">تسجيل الدخول</a>
            </div>
            <div class="text-center mt-2">
                <span class="lg-demo">عرض تجريبي — لا تُحفظ البيانات بعد</span>
            </div>
        </div>
    </div>
</div>
