@{
    var ctl = (ViewContext.RouteData.Values["action"] as string) ?? "";
    string on(string a) => string.Equals(ctl, a, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e7490" />
    <title>@ViewData["Title"] — الشحن اللوجستي</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root { --lg-1:#0b3b46; --lg-2:#0e7490; --lg-3:#06b6d4; --lg-4:#22d3ee; --lg-bg:#f0fbfd; }
        body { background: var(--lg-bg); font-family: 'IBM Plex Sans Arabic','Segoe UI',Tahoma,sans-serif; color:#0f172a; margin:0; }
        a { text-decoration: none; }

        .lg-nav { background:#fff; border-bottom:1px solid #d8eef2; position:sticky; top:0; z-index:50;
                  box-shadow:0 2px 12px rgba(14,116,144,.06); }
        .lg-nav-in { max-width:1200px; margin:0 auto; display:flex; align-items:center; gap:18px; padding:12px 20px; }
        .lg-brand { display:flex; align-items:center; gap:11px; }
        .lg-mark { width:42px; height:42px; border-radius:12px; display:grid; place-items:center; color:#fff;
                   background:linear-gradient(135deg,var(--lg-2),var(--lg-3)); box-shadow:0 6px 16px rgba(14,116,144,.3); }
        .lg-mark svg { width:24px; height:24px; }
        .lg-brand b { font-size:18px; color:var(--lg-1); display:block; line-height:1.1; }
        .lg-brand span { font-size:11px; color:#64748b; }
        .lg-links { display:flex; gap:4px; margin-inline-start:10px; }
        .lg-links a { padding:8px 14px; border-radius:9px; color:#334155; font-weight:600; font-size:14px; }
        .lg-links a:hover { background:#ecfeff; color:var(--lg-2); }
        .lg-links a.active { background:var(--lg-2); color:#fff; }
        .lg-right { margin-inline-start:auto; display:flex; align-items:center; gap:8px; }
        .lg-demo { font-size:11px; font-weight:700; color:#a16207; background:#fef9c3; border:1px solid #fde68a;
                   padding:4px 10px; border-radius:999px; }
        .lg-btn { padding:9px 18px; border-radius:10px; font-weight:700; font-size:14px; border:0; cursor:pointer; display:inline-flex; align-items:center; gap:8px; }
        .lg-btn-primary { background:linear-gradient(135deg,var(--lg-2),var(--lg-3)); color:#fff; box-shadow:0 8px 20px rgba(14,116,144,.28); }
        .lg-btn-ghost { background:transparent; color:var(--lg-2); border:1.5px solid #a5e8f2; }
        .lg-btn:hover { filter:brightness(1.05); transform:translateY(-1px); transition:.2s; }
        .lg-back { font-size:12.5px; color:#64748b; }
        .lg-back:hover { color:var(--lg-2); }

        .lg-main { max-width:1200px; margin:0 auto; padding:26px 20px 60px; }
        .lg-card { background:#fff; border:1px solid #e2eef1; border-radius:16px; box-shadow:0 6px 24px rgba(2,44,54,.05); }

        .lg-foot { text-align:center; color:#64748b; font-size:12.5px; padding:26px 16px 34px; border-top:1px solid #e2eef1; background:#fff; }
        .lg-foot b { color:var(--lg-2); }

        .lg-pill { display:inline-block; font-size:11px; font-weight:700; padding:4px 10px; border-radius:999px; }
        .lg-pill-cold { background:#e0f2fe; color:#0369a1; }
        .lg-pill-ready { background:#dcfce7; color:#15803d; }
        .lg-pill-prep { background:#fef3c7; color:#b45309; }

        @@media (max-width:820px){ .lg-links{ display:none; } }
    </style>
</head>
<body>
    <nav class="lg-nav">
        <div class="lg-nav-in">
            <a class="lg-brand" asp-controller="Shipping" asp-action="Index">
                <span class="lg-mark">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h1"/><path d="M14 9h4l3 3v5a1 1 0 0 1-1 1h-1"/><circle cx="6.5" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/></svg>
                </span>
                <span><b>الشحن اللوجستي</b><span>منصة النقل والتوصيل</span></span>
            </a>
            <div class="lg-links">
                <a class="@on("Index")" asp-controller="Shipping" asp-action="Index">الرئيسية</a>
                <a class="@on("Dashboard")" asp-controller="Shipping" asp-action="Dashboard">لوحة الناقل</a>
                <a asp-controller="Shipping" asp-action="Dashboard">الشحنات المتاحة</a>
            </div>
            <div class="lg-right">
                <span class="lg-demo">عرض تجريبي</span>
                <a class="lg-btn lg-btn-ghost" asp-controller="Shipping" asp-action="Login">تسجيل الدخول</a>
                <a class="lg-btn lg-btn-primary" asp-controller="Shipping" asp-action="Register">سجّل كناقل</a>
            </div>
        </div>
    </nav>

    <main class="lg-main">
        @RenderBody()
    </main>

    <footer class="lg-foot">
        <div style="margin-bottom:6px;">
            <a class="lg-back" href="/">← العودة إلى بوابة الدخول</a>
        </div>
        <b>منصة الشحن اللوجستي</b> — نسخة عرض تجريبية منفصلة عن منصة ساوم، متصلة بها عبر API لجلب الشحنات.
        <br>المنصة تربط وتوثّق فقط، ولا تتحمل مسؤولية النقل أو التخزين أو التأمين. © @DateTime.Now.Year
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
