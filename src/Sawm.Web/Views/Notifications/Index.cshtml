@model List<Notification>
@{
    ViewData["Title"] = "الإشعارات";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0">الإشعارات</h5>
    @if (Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-outline-secondary">تعليم الكل كمقروء</button>
        </form>
    }
</div>

<div class="card">
    <ul class="list-group list-group-flush">
    @if (!Model.Any())
    {
        <li class="list-group-item text-center text-muted py-5">لا توجد إشعارات.</li>
    }
    @foreach (var n in Model)
    {
        <li class="list-group-item @(n.IsRead ? "" : "bg-light")">
            <a class="text-decoration-none text-dark d-block" asp-action="Open" asp-route-id="@n.Id">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <div class="fw-semibold">@n.Title @if (!n.IsRead) { <span class="badge bg-danger">جديد</span> }</div>
                        <div class="text-muted small">@n.Body</div>
                    </div>
                    <div class="muted-label rtl-num text-nowrap">@n.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                </div>
            </a>
        </li>
    }
    </ul>
</div>
