@{
    Layout = null;
    ViewData["Title"] = "بوابة الدخول";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15803D" />
    <title>بوابة الدخول — منصة ساوم</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --gw-green-1: #14532d; --gw-green-2: #15803d; --gw-green-3: #22c55e;
            --gw-teal-1: #0b3b46; --gw-teal-2: #0e7490; --gw-teal-3: #06b6d4;
        }
        * { box-sizing: border-box; }
        html, body { height: 100%; }
        .gw-body {
            margin: 0; min-height: 100vh; overflow: hidden;
            font-family: 'IBM Plex Sans Arabic', 'Segoe UI', Tahoma, sans-serif;
            display: flex; flex-direction: column; background: #0a0f0d;
        }

        /* الشريط العلوي */
        .gw-topbar {
            position: absolute; top: 0; inset-inline: 0; z-index: 20;
            display: flex; align-items: center; justify-content: space-between;
            padding: 18px 28px; color: #fff; pointer-events: none;
            animation: gwDrop .8s cubic-bezier(.2,.8,.2,1) both;
        }
        .gw-brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 20px; letter-spacing: .3px; }
        .gw-mark {
            width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center;
            background: linear-gradient(135deg, var(--gw-green-2), var(--gw-teal-2));
            box-shadow: 0 6px 20px rgba(0,0,0,.35); font-size: 22px; font-weight: 900;
        }
        .gw-hint { font-size: 13px; color: #cbd5e1; opacity: .9; }

        /* الشاشة المنقسمة */
        .gw-split { flex: 1; display: flex; min-height: 100vh; }
        .gw-gate {
            position: relative; flex: 1; overflow: hidden; text-decoration: none; color: #fff;
            display: flex; align-items: center; justify-content: center;
            transition: flex-grow .6s cubic-bezier(.2,.8,.2,1), filter .5s ease;
            filter: saturate(.92);
        }
        .gw-split:hover .gw-gate { flex-grow: .85; }
        .gw-split:hover .gw-gate:hover { flex-grow: 1.35; filter: saturate(1.1) brightness(1.06); }

        .gw-sawm { background: radial-gradient(120% 120% at 70% 20%, var(--gw-green-3) 0%, var(--gw-green-2) 40%, var(--gw-green-1) 100%); animation: gwInRight .9s cubic-bezier(.2,.8,.2,1) both; }
        .gw-logi { background: radial-gradient(120% 120% at 30% 20%, var(--gw-teal-3) 0%, var(--gw-teal-2) 42%, var(--gw-teal-1) 100%); animation: gwInLeft .9s cubic-bezier(.2,.8,.2,1) both; }

        /* حاجز مائل بين البوابتين */
        .gw-gate::after {
            content: ""; position: absolute; inset: 0;
            background: linear-gradient(115deg, transparent 46%, rgba(255,255,255,.06) 50%, transparent 54%);
            opacity: 0; transition: opacity .5s ease;
        }
        .gw-gate:hover::after { opacity: 1; }

        /* علامة مائية كبيرة في الخلفية */
        .gw-watermark {
            position: absolute; inset-block: -8%; inset-inline-start: -6%;
            width: 62%; opacity: .10; color: #fff; pointer-events: none;
            animation: gwFloat 9s ease-in-out infinite;
        }
        .gw-logi .gw-watermark { inset-inline-start: auto; inset-inline-end: -6%; animation-delay: -3s; }

        .gw-inner { position: relative; z-index: 2; text-align: center; padding: 32px; max-width: 460px; }
        .gw-badge {
            display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .5px;
            padding: 6px 14px; border-radius: 999px; margin-bottom: 22px;
            background: rgba(255,255,255,.16); backdrop-filter: blur(4px);
            border: 1px solid rgba(255,255,255,.25);
        }
        .gw-iconwrap {
            width: 108px; height: 108px; margin: 0 auto 24px; border-radius: 28px;
            display: grid; place-items: center; color: #fff;
            background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.28);
            box-shadow: 0 18px 50px rgba(0,0,0,.28), inset 0 1px 0 rgba(255,255,255,.25);
            transition: transform .5s cubic-bezier(.2,.8,.2,1), background .4s ease;
        }
        .gw-gate:hover .gw-iconwrap { transform: translateY(-6px) scale(1.06) rotate(-3deg); background: rgba(255,255,255,.22); }
        .gw-iconwrap svg { width: 56px; height: 56px; }

        .gw-title { color: #fff; font-size: 30px; font-weight: 800; margin: 0 0 12px; text-shadow: 0 2px 16px rgba(0,0,0,.35); }
        .gw-desc { font-size: 15.5px; line-height: 1.9; color: rgba(255,255,255,.92); margin: 0 auto 26px; max-width: 380px; }
        .gw-cta {
            display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 15px;
            padding: 13px 30px; border-radius: 14px; color: #0f172a; background: #fff;
            box-shadow: 0 12px 30px rgba(0,0,0,.28); transition: gap .3s ease, transform .3s ease;
        }
        .gw-gate:hover .gw-cta { gap: 16px; transform: translateY(-2px); }
        .gw-cta svg { width: 18px; height: 18px; }

        .gw-foot {
            position: absolute; bottom: 0; inset-inline: 0; z-index: 20; text-align: center;
            padding: 14px; color: rgba(255,255,255,.75); font-size: 12px; pointer-events: none;
            animation: gwDrop 1s .2s cubic-bezier(.2,.8,.2,1) both;
        }

        @@keyframes gwInRight { from { opacity: 0; transform: translateX(60px); } to { opacity: 1; transform: none; } }
        @@keyframes gwInLeft  { from { opacity: 0; transform: translateX(-60px); } to { opacity: 1; transform: none; } }
        @@keyframes gwDrop    { from { opacity: 0; transform: translateY(-18px); } to { opacity: 1; transform: none; } }
        @@keyframes gwFloat   { 0%,100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-18px) rotate(3deg); } }

        /* الجوال: تكديس عمودي */
        @@media (max-width: 820px) {
            .gw-body { overflow: auto; }
            .gw-split { flex-direction: column; }
            .gw-gate { min-height: 52vh; flex: none; }
            .gw-split:hover .gw-gate, .gw-split:hover .gw-gate:hover { flex-grow: 0; filter: none; }
            .gw-title { font-size: 26px; }
            .gw-topbar { position: relative; }
            .gw-foot { position: relative; }
        }
        @@media (prefers-reduced-motion: reduce) {
            .gw-body *, .gw-body *::after { animation: none !important; transition: none !important; }
        }
    </style>
</head>
<body class="gw-body">
    <header class="gw-topbar">
        <div class="gw-brand"><span class="gw-mark">س</span> منصة ساوم</div>
        <div class="gw-hint">اختر بوّابتك للمتابعة</div>
    </header>

    <main class="gw-split">
        <!-- بوابة منصة ساوم -->
        <a class="gw-gate gw-sawm" asp-controller="Home" asp-action="Sawm" aria-label="بوابة منصة ساوم">
            <svg class="gw-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 22 16 8" /><path d="M3.47 12.53 5 11l1.53 1.53a3.5 3.5 0 0 1 0 4.94L5 19l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z" /><path d="M7.47 8.53 9 7l1.53 1.53a3.5 3.5 0 0 1 0 4.94L9 15l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z" /><path d="M11.47 4.53 13 3l1.53 1.53a3.5 3.5 0 0 1 0 4.94L13 11l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z" />
            </svg>
            <div class="gw-inner">
                <span class="gw-badge">السوق الزراعي</span>
                <div class="gw-iconwrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 20h10" /><path d="M12 20c0-6 0-8-3-10" /><path d="M12 14c0-4 2-6 6-6 0 4-2 6-6 6Z" /><path d="M12 12C12 9 10 7 6 7c0 3 2 5 6 5Z" />
                    </svg>
                </div>
                <h1 class="gw-title">بوابة منصة ساوم</h1>
                <p class="gw-desc">سوق المحاصيل الذكي — مزادات ومناقصات وعقود رقمية موثّقة تربط المزارع بالوسيط والشركة.</p>
                <span class="gw-cta">
                    الدخول إلى المنصة
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
                </span>
            </div>
        </a>

        <!-- بوابة الشحن اللوجستي -->
        <a class="gw-gate gw-logi" asp-controller="Shipping" asp-action="Index" aria-label="بوابة الشحن اللوجستي">
            <svg class="gw-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 18V6a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h1" /><path d="M14 9h4l3 3v5a1 1 0 0 1-1 1h-1" /><circle cx="6.5" cy="18" r="2" /><circle cx="17.5" cy="18" r="2" />
            </svg>
            <div class="gw-inner">
                <span class="gw-badge">النقل والشحن</span>
                <div class="gw-iconwrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 18V6a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h1" /><path d="M14 9h4l3 3v5a1 1 0 0 1-1 1h-1" /><circle cx="6.5" cy="18" r="2" /><circle cx="17.5" cy="18" r="2" />
                    </svg>
                </div>
                <h1 class="gw-title">بوابة الشحن اللوجستي</h1>
                <p class="gw-desc">سوق النقل والشحن — اربط شحناتك بمزوّدي خدمات النقل بعروض تنافسية موثّقة، من الاستلام حتى التسليم.</p>
                <span class="gw-cta">
                    الدخول إلى اللوجستيات
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
                </span>
            </div>
        </a>
    </main>

    <footer class="gw-foot">المنصة تربط وتوثّق وتضمن رقمياً فقط — ولا تتحمل مسؤولية النقل أو التخزين أو التأمين.</footer>
</body>
</html>
